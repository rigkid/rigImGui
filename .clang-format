BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Always
ContinuationIndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left
SortIncludes: true
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<(windows|glad)/'
    Priority: -1
  - Regex: '^"rendering/U_gladGlfw\.h"'
    Priority: 0
  - Regex: '^<glm/'
    Priority: 1
  # imgui.h before imfilebrowser.h (the latter requires ImGui types first).
  - Regex: '^[<"]imgui\.h[>"]'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  # Host before packs/ (see docs/includes.md). Short pack names ("rig.h") stay Priority 6.
  - Regex: '^"(core|ecs|rendering)/'
    Priority: 4
  - Regex: '^"packs/'
    Priority: 5
  - Regex: '^"'
    Priority: 6
